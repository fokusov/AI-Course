{
  "version": 1,
  "textExtensions": [
    ".txt",
    ".md",
    ".json",
    ".yaml",
    ".yml",
    ".xml",
    ".bsl",
    ".feature",
    ".ps1",
    ".log",
    ".csv"
  ],
  "maxFileBytes": 5242880,
  "rules": [
    {
      "id": "synthetic-forbidden-canary",
      "kind": "literal",
      "pattern": "FORBIDDEN-CANARY-7F3A9D"
    },
    {
      "id": "production-domain-canary",
      "kind": "literal",
      "pattern": "prod-customer.invalid"
    },
    {
      "id": "private-key-header",
      "kind": "regex",
      "pattern": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----"
    },
    {
      "id": "generic-bearer-token",
      "kind": "regex",
      "pattern": "(?i)authorization\\s*[:=]\\s*bearer\\s+[a-z0-9._-]{12,}"
    }
  ]
}
