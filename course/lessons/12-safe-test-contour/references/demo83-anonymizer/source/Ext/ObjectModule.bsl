	Счет.Номер = "40817810000000001234";
	Счет.Банк = Банк.Ссылка;
	Счет.Записать();

	Пользователь = ПолучитьИлиСоздатьCanary(Справочники.Пользователи, "Справочник.Пользователи");
	Пользователь.Наименование = "CANARY Реальный пользователь";
	Пользователь.Записать();

	Входящее = ПолучитьИлиСоздатьCanary(Справочники.ВходящиеПисьма, "Справочник.ВходящиеПисьма");
	Входящее.Дата = ТекущаяДата();
	Входящее.Отправитель = "canary.sender@example.com";
	Входящее.Текст = "CANARY секретный текст входящего письма";
	Входящее.Идентификатор = "CANARY-MESSAGE-ID";
	Входящее.ПочтовыйЯщик = "canary.mailbox@example.com";
	Входящее.Записать();

	Исходящее = ПолучитьИлиСоздатьCanary(Справочники.ИсходящиеПисьма, "Справочник.ИсходящиеПисьма");
	Исходящее.Дата = ТекущаяДата();
	Исходящее.Текст = "CANARY секретный текст исходящего письма";
	Исходящее.Контрагент = Контрагент.Ссылка;
	Исходящее.Содержимое = Новый ХранилищеЗначения("CANARY_SECRET_MAIL_PAYLOAD");
	Исходящее.Получатели.Очистить();
	СтрокаПолучателя = Исходящее.Получатели.Добавить();
	СтрокаПолучателя.ЭлектроннаяПочта = "canary.receiver@example.com";
	Исходящее.Записать();

	Файл = ПолучитьИлиСоздатьCanary(Справочники.ХранимыеФайлы, "Справочник.ХранимыеФайлы");
	Файл.Владелец = Контрагент.Ссылка;
