	Контрагент.Широта = 55.7558;
	Контрагент.Долгота = 37.6173;
	Контрагент.Записать();

	Организация = ПолучитьИлиСоздатьCanary(Справочники.Организации, "Справочник.Организации");
	Организация.Наименование = "CANARY ООО Реальная организация";
	Организация.Записать();
	Банк = ПолучитьИлиСоздатьCanary(Справочники.Банки, "Справочник.Банки");
	Банк.Наименование = "CANARY Реальный банк";
	Банк.Записать();

	Счет = ПолучитьИлиСоздатьCanary(Справочники.РасчетныеСчетаКонтрагентов, "Справочник.РасчетныеСчетаКонтрагентов");
	Счет.Владелец = Контрагент.Ссылка;
