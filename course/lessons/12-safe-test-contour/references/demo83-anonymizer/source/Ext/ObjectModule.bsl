	Файл.Подпись = Новый ХранилищеЗначения("CANARY_SECRET_SIGNATURE");
	Файл.Подписан = Истина;
	Файл.Зашифрован = Истина;
	Файл.ДляОписания = Истина;
	Файл.Записать();
КонецПроцедуры

