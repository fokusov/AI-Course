	Если ВидЦен = Неопределено Тогда ВызватьИсключение "CANARY_PRICE_TYPE_REQUIRED"; КонецЕсли;

	Контрагент = ПолучитьИлиСоздатьCanary(Справочники.Контрагенты, "Справочник.Контрагенты");
	Контрагент.Наименование = "CANARY Иванов И.И.";
	Контрагент.ВидЦен = ВидЦен;
	Контрагент.Индекс = "123456";
	Контрагент.Страна = "CANARY Реальная страна";
	Контрагент.Город = "CANARY Реальный город";
