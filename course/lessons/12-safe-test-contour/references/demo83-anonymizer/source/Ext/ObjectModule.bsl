// Учебная обработка: canary-пилот затрагивает только записи с точным маркером AICANARY.
// Полный прогон закрыт до отдельной приемки всех destructive-гейтов.

Функция СформироватьИнвентарьИПлан() Экспорт
	План = Новый Массив;
	ДобавитьСтадию(План, "Контрагенты", "Справочник.Контрагенты", "CANARY_REPLACE");
	ДобавитьСтадию(План, "Организации", "Справочник.Организации", "CANARY_REPLACE");
	ДобавитьСтадию(План, "Банки", "Справочник.Банки", "CANARY_REPLACE");
	ДобавитьСтадию(План, "РасчетныеСчетаКонтрагентов", "Справочник.РасчетныеСчетаКонтрагентов", "CANARY_REPLACE");
	ДобавитьСтадию(План, "Пользователи", "Справочник.Пользователи", "CANARY_REPLACE");
	ДобавитьСтадию(План, "ВходящиеПисьма", "Справочник.ВходящиеПисьма", "CANARY_CLEAR");
	ДобавитьСтадию(План, "ИсходящиеПисьма", "Справочник.ИсходящиеПисьма", "CANARY_CLEAR");
	ДобавитьСтадию(План, "ХранимыеФайлы", "Справочник.ХранимыеФайлы", "CANARY_CLEAR");
	ДобавитьСтадию(План, "ИсторияДанных", "Все поддержанные типы", "NOT_RUN_IN_CANARY_MODE");
	ДобавитьСтадию(План, "Интеграции", "Константы", "NOT_RUN_IN_CANARY_MODE");
	Возврат Новый Структура("stages,residual_risks,supported_stage_status,overall_decision",
		План, ПолучитьОстаточныеРиски(), "CANARY_ONLY", "REVIEW_REQUIRED");
КонецФункции

Функция ВыполнитьСПодтверждениями(РаботаюСОтдельнойКопией, Фраза) Экспорт
	Возврат Новый Структура("status,codes", "BLOCKED", МассивСКодом("FULL_RUN_NOT_RELEASED"));
КонецФункции

Функция ПодготовитьCanary(РаботаюСОтдельнойКопией, Фраза) Экспорт
	Ошибки = ПроверитьКонтур(РаботаюСОтдельнойКопией);
	Если Фраза <> "СОЗДАТЬ CANARY DEMO83" Тогда Ошибки.Добавить("CANARY_PHRASE_REQUIRED"); КонецЕсли;
	Если Ошибки.Количество() > 0 Тогда
		Возврат Новый Структура("status,codes", "BLOCKED", Ошибки);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		СоздатьИлиОбновитьCanary();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат РезультатОшибки("CANARY_PREPARE_FAILED", ОписаниеОшибки());
	КонецПопытки;
	Возврат ПроверитьCanaryДоОбезличивания();
КонецФункции

Функция ВыполнитьCanaryСПодтверждениями(РаботаюСОтдельнойКопией, Фраза) Экспорт
	Ошибки = ПроверитьКонтур(РаботаюСОтдельнойКопией);
	Если Фраза <> "ОБЕЗЛИЧИТЬ CANARY DEMO83" Тогда Ошибки.Добавить("CANARY_RUN_PHRASE_REQUIRED"); КонецЕсли;
	Если Не ПолныйКомплектCanary() Тогда Ошибки.Добавить("CANARY_SET_REQUIRED"); КонецЕсли;
	Если Ошибки.Количество() > 0 Тогда
		Возврат Новый Структура("status,codes", "BLOCKED", Ошибки);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ОбезличитьCanary();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат РезультатОшибки("CANARY_RUN_FAILED", ОписаниеОшибки());
	КонецПопытки;
	Возврат ПроверитьCanaryПослеОбезличивания();
КонецФункции

Функция ПроверитьCanary() Экспорт
	Если Не ПолныйКомплектCanary() Тогда
		Возврат Новый Структура("status,codes", "BLOCKED", МассивСКодом("CANARY_SET_REQUIRED"));
	КонецЕсли;
	Возврат ПроверитьCanaryПослеОбезличивания();
КонецФункции

Функция ПроверитьКонтур(ОтдельнаяКопия)
	Ошибки = Новый Массив;
	Если Метаданные.Имя <> "ДемонстрационноеПриложение" Тогда Ошибки.Добавить("CONFIGURATION_NAME_UNSUPPORTED"); КонецЕсли;
	Если Метаданные.Версия <> "1.0.41.3" Тогда Ошибки.Добавить("CONFIGURATION_VERSION_UNSUPPORTED"); КонецЕсли;
	Если Не ОтдельнаяКопия Тогда Ошибки.Добавить("COPY_CONFIRMATION_REQUIRED"); КонецЕсли;
	Возврат Ошибки;
КонецФункции

Процедура СоздатьИлиОбновитьCanary()
