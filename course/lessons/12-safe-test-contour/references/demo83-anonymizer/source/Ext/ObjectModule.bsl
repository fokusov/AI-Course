Функция ПроверитьCanaryДоОбезличивания()
	Коды = Новый Массив;
	Если Не ПолныйКомплектCanary() Тогда Коды.Добавить("CANARY_SET_INCOMPLETE"); КонецЕсли;
	Контрагент = ПолучитьCanaryОбъект("Справочник.Контрагенты");
	Если Контрагент <> Неопределено И Контрагент.ЭлектроннаяПочта <> "canary.person@example.com" Тогда Коды.Добавить("CANARY_SOURCE_MARKERS_MISSING"); КонецЕсли;
	Возврат РезультатПроверки(Коды, "CANARY_PREPARED");
КонецФункции

Функция ПроверитьCanaryПослеОбезличивания()
	Коды = Новый Массив;
	Контрагент = ПолучитьCanaryОбъект("Справочник.Контрагенты");
	Если Контрагент = Неопределено Тогда
		Коды.Добавить("COUNTERPARTY_CANARY_MISSING");
	ИначеЕсли Контрагент.Наименование <> "AI Контрагент 1" ИЛИ Контрагент.ЭлектроннаяПочта <> "ai_1@example.invalid"
		ИЛИ Контрагент.ДополнительнаяИнформация <> "AI synthetic text" Тогда
		Коды.Добавить("COUNTERPARTY_NOT_ANONYMIZED");
	КонецЕсли;
	ПроверитьНаименованиеCanary("Справочник.Организации", "AI Организация 1", "ORGANIZATION_NOT_ANONYMIZED", Коды);
	ПроверитьНаименованиеCanary("Справочник.Банки", "AI Банк 1", "BANK_NOT_ANONYMIZED", Коды);
	ПроверитьНаименованиеCanary("Справочник.Пользователи", "AI Пользователь 1", "USER_NOT_ANONYMIZED", Коды);

	Счет = ПолучитьCanaryОбъект("Справочник.РасчетныеСчетаКонтрагентов");
	Если Счет = Неопределено ИЛИ Счет.Номер <> "00000000000000000001" Тогда Коды.Добавить("ACCOUNT_NOT_ANONYMIZED"); КонецЕсли;
	Входящее = ПолучитьCanaryОбъект("Справочник.ВходящиеПисьма");
	Если Входящее = Неопределено ИЛИ Не ПустаяСтрока(Входящее.Отправитель) ИЛИ Не ПустаяСтрока(Входящее.Текст)
		ИЛИ Не ПустаяСтрока(Входящее.ПочтовыйЯщик) Тогда Коды.Добавить("INCOMING_MAIL_NOT_CLEARED"); КонецЕсли;

	Исходящее = ПолучитьCanaryОбъект("Справочник.ИсходящиеПисьма");
	Если Исходящее = Неопределено ИЛИ Не ПустаяСтрока(Исходящее.Текст) ИЛИ Исходящее.Содержимое.Получить() <> "" Тогда
		Коды.Добавить("OUTGOING_MAIL_NOT_CLEARED");
	Иначе
		Для Каждого Получатель Из Исходящее.Получатели Цикл
			Если Не ПустаяСтрока(Получатель.ЭлектроннаяПочта) Тогда Коды.Добавить("OUTGOING_RECIPIENT_NOT_CLEARED"); Прервать; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Файл = ПолучитьCanaryОбъект("Справочник.ХранимыеФайлы");
	Если Файл = Неопределено ИЛИ Файл.ИмяФайла <> "AI_file_1.bin" ИЛИ Файл.ДанныеФайла.Получить() <> ""
		ИЛИ Файл.Подпись.Получить() <> "" ИЛИ Файл.Подписан ИЛИ Файл.Зашифрован ИЛИ Файл.ДляОписания Тогда
		Коды.Добавить("STORED_FILE_NOT_CLEARED");
	КонецЕсли;
	Возврат РезультатПроверки(Коды, "CANARY_ANONYMIZED");
КонецФункции

Функция ПолныйКомплектCanary()
	Таблицы = Новый Массив;
	Таблицы.Добавить("Справочник.Контрагенты"); Таблицы.Добавить("Справочник.Организации"); Таблицы.Добавить("Справочник.Банки");
	Таблицы.Добавить("Справочник.РасчетныеСчетаКонтрагентов"); Таблицы.Добавить("Справочник.Пользователи");
	Таблицы.Добавить("Справочник.ВходящиеПисьма"); Таблицы.Добавить("Справочник.ИсходящиеПисьма"); Таблицы.Добавить("Справочник.ХранимыеФайлы");
	Для Каждого Таблица Из Таблицы Цикл
		Если ПолучитьCanaryОбъект(Таблица) = Неопределено Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПолучитьИлиСоздатьCanary(Менеджер, Таблица)
	Объект = ПолучитьCanaryОбъект(Таблица);
	Если Объект = Неопределено Тогда
		Объект = Менеджер.СоздатьЭлемент();
		Если ПолеCanary(Таблица) = "Код" Тогда
			Объект.Код = "AICANARY";
		Иначе
			Объект.Наименование = "AICANARY";
		КонецЕсли;
	КонецЕсли;
	Возврат Объект;
КонецФункции

Функция ПолучитьCanaryОбъект(Таблица)
	Поле = ПолеCanary(Таблица);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ " + Таблица + " ГДЕ " + Поле + " = &Маркер");
	Запрос.УстановитьПараметр("Маркер", "AICANARY");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда Возврат Неопределено; КонецЕсли;
	Ссылка = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда ВызватьИсключение "CANARY_DUPLICATE"; КонецЕсли;
	Возврат Ссылка.ПолучитьОбъект();
КонецФункции

Функция ПолеCanary(Таблица)
	Если Таблица = "Справочник.ВходящиеПисьма" ИЛИ Таблица = "Справочник.ИсходящиеПисьма" Тогда
		Возврат "Наименование";
	КонецЕсли;
	Возврат "Код";
КонецФункции

Функция ПервыйВидЦен()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыЦен ГДЕ НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ПроверитьНаименованиеCanary(Таблица, Ожидаемое, КодОшибки, Коды)
	Объект = ПолучитьCanaryОбъект(Таблица);
	Если Объект = Неопределено ИЛИ Объект.Наименование <> Ожидаемое Тогда Коды.Добавить(КодОшибки); КонецЕсли;
КонецПроцедуры

Функция РезультатПроверки(Коды, УспешныйКод)
	Если Коды.Количество() = 0 Тогда
		Коды.Добавить(УспешныйКод);
		Возврат Новый Структура("status,codes", "PASS", Коды);
	КонецЕсли;
	Возврат Новый Структура("status,codes", "BLOCKED", Коды);
КонецФункции

Функция РезультатОшибки(Код, Детали)
	Коды = Новый Массив; Коды.Добавить(Код); Коды.Добавить(Детали);
	Возврат Новый Структура("status,codes", "BLOCKED", Коды);
КонецФункции

Функция МассивСКодом(Код)
	Результат = Новый Массив; Результат.Добавить(Код); Возврат Результат;
КонецФункции

Процедура ДобавитьСтадию(План, Код, Класс, Действие)
	План.Добавить(Новый Структура("stage_code,object_class,action,status,residual_risk", Код, Класс, Действие, "PENDING", ПолучитьОстаточныеРиски()));
КонецПроцедуры

Функция СинтетическаяСтрока(Класс, Поле, Номер, МаксимальнаяДлина) Экспорт
	Значение = "AI_" + Класс + "_" + Поле + "_" + Строка(Номер);
	Если МаксимальнаяДлина > 0 Тогда Возврат Лев(Значение, МаксимальнаяДлина); КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СинтетическийНомерСчета(Номер, Длина) Экспорт
	Возврат Прав("00000000000000000000" + Формат(Номер, "ЧГ=0"), Длина);
КонецФункции

Функция ПолучитьОстаточныеРиски()
	Возврат "Canary-пилот не очищает историю, константы, документы, регистры, журнал регистрации, backups, dt и внешние файлы";
КонецФункции
