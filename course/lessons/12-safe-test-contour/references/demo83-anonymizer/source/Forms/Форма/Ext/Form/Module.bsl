&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ПараметрЗапуска = "AI_CANARY_REHEARSAL" ИЛИ ПараметрЗапуска = "AI_CANARY_VERIFY" Тогда
		ПодключитьОбработчикОжидания("ВыполнитьАвтоматическийСценарий", 0.1, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвтоматическийСценарий()
	Попытка
		Если ПараметрЗапуска = "AI_CANARY_VERIFY" Тогда
			Проверка = ПроверитьCanaryНаСервере();
			Отчет = "mode=verify" + Символы.ПС + "verify=" + ПредставитьРезультат(Проверка);
		Иначе
			Подготовка = ПодготовитьCanaryНаСервере(Истина, "СОЗДАТЬ CANARY DEMO83");
			Если Подготовка.status = "PASS" Тогда
				Запуск = ВыполнитьНаСервере(Истина, "ОБЕЗЛИЧИТЬ CANARY DEMO83");
			Иначе
				Запуск = Новый Структура("status,codes", "BLOCKED", Новый Массив);
				Запуск.codes.Добавить("PREPARE_NOT_PASSED");
			КонецЕсли;
			Если Запуск.status = "PASS" Тогда
				Проверка = ПроверитьCanaryНаСервере();
			Иначе
				Проверка = Новый Структура("status,codes", "BLOCKED", Новый Массив);
				Проверка.codes.Добавить("RUN_NOT_PASSED");
			КонецЕсли;
			Отчет = "mode=rehearsal" + Символы.ПС
				+ "prepare=" + ПредставитьРезультат(Подготовка) + Символы.ПС
				+ "run=" + ПредставитьРезультат(Запуск) + Символы.ПС
				+ "verify=" + ПредставитьРезультат(Проверка);
		КонецЕсли;
	Исключение
		Отчет = "mode=" + ПараметрЗапуска + Символы.ПС + "exception=" + ОписаниеОшибки();
	КонецПопытки;

	Попытка
		ЗаписатьRehearsalEvidence(Отчет);
	Исключение
		Сообщить("Не удалось записать rehearsal evidence: " + ОписаниеОшибки());
	КонецПопытки;
	Закрыть();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьRehearsalEvidence(Текст)
	Путь = "C:\AI-Course-Work\Demo83-Sources\.build\external-anonymizer\canary-runtime-result.txt";
	Запись = Новый ЗаписьТекста;
	Запись.Открыть(Путь, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(Текст);
	Запись.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПлан(Команда)
	Результат = СформироватьПланНаСервере();
	План.Очистить();
	Для Каждого СтрокаПлана Из Результат.stages Цикл
		СтрокаФормы = План.Добавить(); СтрокаФормы.stage_code = СтрокаПлана.stage_code; СтрокаФормы.status = СтрокаПлана.status; СтрокаФормы.residual_risk = СтрокаПлана.residual_risk;
	КонецЦикла;
	Отчет = "Инвентарь сформирован. Статус: " + Результат.supported_stage_status + Символы.ПС + Результат.residual_risks;
КонецПроцедуры
&НаСервере
Функция СформироватьПланНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.СформироватьИнвентарьИПлан();
КонецФункции

&НаКлиенте
Процедура ПодготовитьУчебныеДанные(Команда)
	Результат = ПодготовитьCanaryНаСервере(РаботаюСОтдельнойКопией, ФразаCanary);
	Отчет = ПредставитьРезультат(Результат);
КонецПроцедуры
&НаСервере
Функция ПодготовитьCanaryНаСервере(ОтдельнаяКопия, Фраза) 
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПодготовитьCanary(ОтдельнаяКопия, Фраза);
КонецФункции

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	Результат = ВыполнитьНаСервере(РаботаюСОтдельнойКопией, ФразаЗапуска);
	Отчет = ПредставитьРезультат(Результат);
КонецПроцедуры
&НаСервере
Функция ВыполнитьНаСервере(ОтдельнаяКопия, Фраза)
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ВыполнитьCanaryСПодтверждениями(ОтдельнаяКопия, Фраза);
КонецФункции

&НаКлиенте
Процедура ПроверитьРезультат(Команда)
	Результат = ПроверитьCanaryНаСервере();
	Отчет = ПредставитьРезультат(Результат);
КонецПроцедуры
&НаСервере
Функция ПроверитьCanaryНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПроверитьCanary();
КонецФункции
&НаКлиенте
Процедура СохранитьОтчет(Команда)
	Сообщить(Отчет);
КонецПроцедуры
&НаКлиенте
Функция ПредставитьРезультат(Результат)
	Возврат "Статус: " + Результат.status + Символы.ПС + СтрСоединить(Результат.codes, ", ");
КонецФункции
